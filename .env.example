# Local development settings: cp .env.example .env
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Base URL printed into every QR code. Use the real domain in production.
SITE_URL=http://localhost:8000
TIME_ZONE=America/Chicago

# Optional: Amazon Location Service map tiles (the key works on localhost too).
# Without a key, the map uses raster tiles.
# AWS_REGION=us-east-2
# AWS_LOCATION_API_KEY=
