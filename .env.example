# Copy to .env for local development: cp .env.example .env
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
# SQLite locally; on Render/Railway this is set to the managed Postgres URL.
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Absolute base URL printed into every QR code. Set to your real domain in production.
SITE_URL=http://localhost:8000
TIME_ZONE=America/Chicago
# Map tiles default to Stadia Maps. In production, add your domain at https://client.stadiamaps.com
# (free account, no key needed). To use another provider:
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Error reports (optional): paste the DSN from a free Sentry project (sentry.io, platform Django).
# SENTRY_DSN=
# Proxies in front of the app that add to X-Forwarded-For (1 for nginx, Render, or Railway).
# TRUSTED_PROXIES=1
# Off-server copies of the nightly backup (Lightsail; needs the AWS CLI).
# BACKUP_S3_URI=s3://your-bucket/campus-pulse
