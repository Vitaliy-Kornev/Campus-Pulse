# Copy to .env for local development: cp .env.example .env
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
# SQLite locally; on Render/Railway this is set to the managed Postgres URL.
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Absolute base URL printed into every QR code. Set to your real domain in production.
SITE_URL=http://localhost:8000
TIME_ZONE=America/Chicago
# Map tiles (optional). Defaults to OpenStreetMap's volunteer tile servers; use a
# commercial provider for production traffic.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
